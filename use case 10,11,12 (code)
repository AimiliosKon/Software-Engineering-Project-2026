def join_green_challenge(citizen_id, goal_description, badge_reward, days_limit=7):
    # Διορθώθηκε το indentation εδώ
    time_limit = datetime.now() + timedelta(days=days_limit)

    cursor.execute(
        """
        INSERT INTO GreenChallenge (goal, timeLimit, badgeToUnlock, citizenID)
        VALUES (%s, %s, %s, %s)
        """, (goal_description, time_limit, badge_reward, citizen_id)
    )
    db.commit()
    generated_id = cursor.lastrowid
    print(f"\n--- ΠΧ10 --- \nΤο challenge δημιουργήθηκε με ID: {generated_id}")
    return generated_id

def complete_green_challenge(challenge_id):
    cursor.execute("SELECT * FROM GreenChallenge WHERE challengeID = %s", (challenge_id,))
    challenge = cursor.fetchone()

    if challenge is None:
        print("Δεν βρέθηκε challenge")
        return
    
    # Προσθήκη λογικής ενημέρωσης πόντων (παράδειγμα)
    cursor.execute("UPDATE Citizen SET totalPoints = totalPoints + 50 WHERE citizenID = %s", (challenge['citizenID'],))
    db.commit()
    print("\nΤο challenge ολοκληρώθηκε επιτυχώς και προστέθηκαν πόντοι!")

