# ΠΕΡΙΠΤΩΣΗ ΧΡΗΣΗΣ 6: Επιβράβευση
# BCE: PointsCalculator (Control)
# =====================================================



def add_reward_points(citizen_id, activity):
    activities = {
        "daily_login": 5,
        "correct_recycling": 15,
        "qr_scan": 20,
        "green_challenge": 30
    }



    if activity not in activities:
        print("Μη έγκυρη δραστηριότητα.")
        return



    cursor.execute("SELECT citizenID, totalPoints FROM Citizen WHERE citizenID = %s", (citizen_id,))
    citizen = cursor.fetchone()



    if citizen is None:
        print("[Οθόνη Μηνύματος Σφάλματος] Ο πολίτης δεν βρέθηκε.")
        return



    earned_points = activities[activity]
    new_total = citizen["totalPoints"] + earned_points



    cursor.execute("UPDATE Citizen SET totalPoints = %s WHERE citizenID = %s", (new_total, citizen_id))
    db.commit()



    print(f"[Οθόνη Κερδισμένων Πόντων] +{earned_points} πόντοι από δραστηριότητα '{activity}'")
    print(f"Συνολικοί πόντοι: {new_total}")



def qr_bin_reward(citizen_id, bin_id, gps_confirmed):
    print("\n--- [Λειτουργία] ΣΑΡΩΣΗ QR CODE ΚΑΔΟΥ ---")



    if not gps_confirmed:
        print("[Οθόνη Μηνύματος Σφάλματος] Αποτυχία επιβεβαίωσης GPS. Δεν είστε κοντά στον κάδο!")
        return



    cursor.execute("SELECT binID, location, status FROM RecyclingBin WHERE binID = %s", (bin_id,))
    bin_data = cursor.fetchone()



    if bin_data is None:
        print("[Οθόνη Μηνύματος Σφάλματος] Ο κωδικός QR δεν αντιστοιχεί σε έγκυρο κάδο.")
        return



    if bin_data["status"] != "Λειτουργικός":
        print(f"[Οθόνη Μηνύματος] Ο κάδος στην τοποθεσία {bin_data['location']} είναι εκτός λειτουργίας λόγω βλάβης.")
        return



    print(f"Το σύστημα επιβεβαίωσε τη θέση σας στον κάδο: {bin_data['location']}")
    print("Η ρίψη των υλικών ολοκληρώθηκε ορθά.")
   
    add_reward_points(citizen_id, "qr_scan")



