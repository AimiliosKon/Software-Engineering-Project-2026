# ΠΕΡΙΠΤΩΣΗ ΧΡΗΣΗΣ 5: Εξαργύρωση πόντων
# BCE: PointsCalculator (Control) & ProfileUI (Boundary)
# =====================================================



def redeem_points(citizen_id, reward_id):
    cursor.execute("SELECT citizenID, totalPoints FROM Citizen WHERE citizenID = %s", (citizen_id,))
    citizen = cursor.fetchone()



    if citizen is None:
        print("[Οθόνη Μηνύματος Σφάλματος] Ο πολίτης δεν βρέθηκε.")
        return



    cursor.execute("SELECT rewardID, title, pointsRequired, description FROM Reward WHERE rewardID = %s", (reward_id,))
    reward = cursor.fetchone()



    if reward is None:
        print("[Οθόνη Μηνύματος Σφάλματος] Η επιβράβευση δεν βρέθηκε.")
        return



    current_points = citizen["totalPoints"]
    required_points = reward["pointsRequired"]



    print("\n--- [ProfileUI] ΕΞΑΡΓΥΡΩΣΗ ΠΟΝΤΩΝ ---")
    print(f"Διαθέσιμοι πόντοι προφίλ: {current_points}")
    print(f"Απαιτούμενοι πόντοι για '{reward['title']}': {required_points}")



    if current_points < required_points:
        print(f"[Οθόνη Μηνύματος Σφάλματος] Ανεπαρκές υπόλοιπο. Χρειάζεστε ακόμα {required_points - current_points} πόντους.")
        return



    new_total = current_points - required_points



    cursor.execute("UPDATE Citizen SET totalPoints = %s WHERE citizenID = %s", (new_total, citizen_id))
    db.commit()



    print("Η εξαργύρωση ολοκληρώθηκε επιτυχώς!")
    print(f"Εκδόθηκε το κουπόνι σας: {reward['title']} ({reward['description']})")
    print(f"Νέο υπόλοιπο πόντων: {new_total}")



    cursor.execute("SELECT title, pointsRequired FROM Reward WHERE pointsRequired <= %s", (new_total,))
    next_rewards = cursor.fetchall()
    if next_rewards:
        print("Άλλες προσφορές που μπορείτε να εξαργυρώσετε με το νέο υπόλοιπο:")
        for r in next_rewards:
            print(f"  - {r['title']} ({r['pointsRequired']} πόντοι)")



def donate_points(citizen_id, points, organization_name="Περιβαλλοντική Δράση"):
    cursor.execute("SELECT citizenID, totalPoints FROM Citizen WHERE citizenID = %s", (citizen_id,))
    citizen = cursor.fetchone()



    if citizen is None:
        print("[Οθόνη Μηνύματος Σφάλματος] Ο πολίτης δεν βρέθηκε.")
        return



    if points <= 0:
        print("Σφάλμα: Οι πόντοι πρέπει να είναι θετικός αριθμός.")
        return



    current_points = citizen["totalPoints"]



    print(f"\n--- [ProfileUI] ΔΩΡΕΑ ΠΟΝΤΩΝ ΣΕ {organization_name.upper()} ---")



    if current_points < points:
        print("[Οθόνη Μηνύματος Σφάλματος] Δεν έχετε αρκετούς πόντους για αυτή τη δωρεά.")
        return



    new_total = current_points - points
    cursor.execute("UPDATE Citizen SET totalPoints = %s WHERE citizenID = %s", (new_total, citizen_id))
    db.commit()



    print(f"Η δωρεά {points} πόντων ολοκληρώθηκε επιτυχώς.")
    print("--- [ΕΚΔΟΣΗ] Εκδόθηκε Ψηφιακή Πιστοποίηση Πράσινης Προσφοράς BinGo ---")
    print(f"Νέο υπόλοιπο πόντων: {new_total}")



