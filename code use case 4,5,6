def scan_material(citizen_id, material):
    material = material.lower().strip()



    # Δεδομένα από το Use Case 4 του εγγράφου
    recyclable_materials = {
        "πλαστικό": {
            "bin_type": "Πλαστικό",
            "bin_color": "Μπλε κάδος",
            "instructions": "Ξεπλύνετε τη συσκευασία και συμπιέστε το μπουκάλι.",
            "points": 10
        },
        "χαρτί": {
            "bin_type": "Χαρτί",
            "bin_color": "Μπλε κάδος",
            "instructions": "Το χαρτί πρέπει να είναι καθαρό και στεγνό.",
            "points": 8
        },
        "γυαλί": {
            "bin_type": "Γυαλί",
            "bin_color": "Κάδος γυαλιού",
            "instructions": "Ξεπλύνετε το γυάλινο μπουκάλι και αφαιρέστε το καπάκι.",
            "points": 12
        },
        "αλουμίνιο": {
            "bin_type": "Αλουμίνιο",
            "bin_color": "Μπλε κάδος",
            "instructions": "Ξεπλύνετε το κουτάκι πριν τη ρίψη.",
            "points": 10
        }
    }



    # Εναλλακτική Ροή 2: Υλικά ειδικής διαχείρισης
    special_materials = ["μπαταρία", "μπαταρίες", "ηλεκτρονικό", "ηλεκτρονικά", "λάμπα", "λάμπες"]



    if material in recyclable_materials:
        info = recyclable_materials[material]



        print("\n--- [ScannerUI] ΑΠΟΤΕΛΕΣΜΑ ΣΑΡΩΣΗΣ ---")
        print("Το υλικό αναγνωρίστηκε ως ανακυκλώσιμο.")
        print(f"Υλικό: {material} | Κατάλληλος κάδος: {info['bin_color']}")
        print(f"Οδηγίες προετοιμασίας: {info['instructions']}")
        print(f"Πράσινοι πόντοι που μπορείτε να κερδίσετε: {info['points']}")



        # Ανάκτηση διαθέσιμων κάδων (Control Logic)
        cursor.execute("""
            SELECT binID, materialType, location, status
            FROM RecyclingBin
            WHERE LOWER(materialType) = LOWER(%s)
            AND status = 'Λειτουργικός'
        """, (info["bin_type"],))



        bins = cursor.fetchall()



        if bins:
            print("\n[EcoRoute] Κοντινοί διαθέσιμοι κάδοι στον χάρτη:")
            for b in bins:
                print(f"  -> Κάδος ID: {b['binID']} | Τοποθεσία: {b['location']}")
        else:
            print("\n[Οθόνη Μηνύματος] Δεν βρέθηκε διαθέσιμος λειτουργικός κάδος στην περιοχή.")



    elif material in special_materials:
        print("\n--- [Οθόνη Μηνύματος] ΕΙΔΙΚΗ ΔΙΑΧΕΙΡΙΣΗ ---")
        print("Το υλικό αυτό απαιτεί ειδική ανακύκλωση (Δεν πρέπει να ριφθεί στους κοινούς κάδους).")
        print("Το σύστημα φορτώνει αυτόματα στον χάρτη τα Ειδικά Σημεία Συλλογής (π.χ. κάδους ΣΕΔΙ).")



    else:
        print("\n--- [Οθόνη Μηνύματος] ΜΗ ΑΝΑΚΥΚΛΩΣΙΜΟ ΥΛΙΚΟ ---")
        print("Το υλικό αυτό δεν ανακυκλώνεται. Παρακαλώ ρίξτε το στους κοινούς κάδους.")



